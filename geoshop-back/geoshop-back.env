# Do not set this to True if your server is exposed to internet!
DEBUG=False

PGDATABASE=geoshop
PGUSER=geoshop
PGHOST= geoshop-back-db
PGPORT=5432
PGPASSWORD=geoshop
PGSCHEMA=geoshop


# The folder where the geodata will be uploaded
MEDIA_ROOT=/app/geoshop-back/files
MEDIA_URL=https://geoshop-front/api/files/

ALLOWED_HOST=localhost,127.0.0.1,proxy.example.com,geoshop-front,geoshop-back
ROOTURL=/api

DEFAULT_FROM_EMAIL=no-reply@geoshop.ch
EMAIL_HOST=smtp.example.com
ADMIN_USERNAME=admin
ADMIN_EMAIL_LIST=admin@example.com

# This is used for CORS and to generate links in email templates
FRONT_URL=geoshop-front
FRONT_HREF=
FRONT_PROTOCOL=https
CSRF_COOKIE_DOMAIN=geoshop-front
LOGGING_LEVEL=DEBUG

# Generate this key with Django tools
SECRET_KEY=GenerateOneSecretKey
ADMIN_PASSWORD=Test1234
EXTRACT_USER_PASSWORD=Test1234

AUTO_LEGEND_URL=http://example.com/mapserv?FORMAT=image%2Fpng&TRANSPARENT=true&SERVICE=WMS&VERSION=1.1.1&REQUEST=GetLegendGraphic&LAYER=
INTRA_LEGEND_URL=https://example.com/mapserv_proxy?ogcserver=source+for+image%2Fpng&FORMAT=image%2Fpng&TRANSPARENT=true&SERVICE=WMS&VERSION=1.1.1&REQUEST=GetLegendGraphic&LAYER=
EMAIL_TEST_TO=test@example.com
DEFAULT_LANGUAGE=en

# Geometric settings
DEFAULT_SRID=2056

# Registration enabled by default
REGISTRATION_ENABLED=True

# OIDC parameters
OIDC_ENABLED=True
OIDC_OP_BASE_URL=https://zitadel
OIDC_REDIRECT_BASE_URL=https://geoshop-front/api
ZITADEL_PROJECT="335057704953315333"
OIDC_RP_CLIENT_ID="335057709751599109"
OIDC_PRIVATE_KEYFILE=/keys/private_key.json
MAX_ORDER_AREA=10000
